# Roblox Authentication
# WARNING: Never commit the actual .env file - it contains your account credentials

# Option 1 (Recommended): Open Cloud API Key
# Get from: https://create.roblox.com/dashboard/credentials
# Required permissions: universe-places:write
UNIVERSE_PUSH_API_KEY=

# Option 2: Browser Cookie (fallback if no API key)
# Get from: Developer Tools > Application > Cookies > .roblox.com > .ROBLOSECURITY
ROBLOSECURITY=