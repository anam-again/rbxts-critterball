{
  "name": "Critterball-Lobby",
  "globIgnorePaths": ["**/package.json", "**/tsconfig.json"],
  "tree": {
    "$className": "DataModel",
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "TS": {
        "$className": "Folder",
        "lobby": {
          "$path": "out/lobby/server"
        }
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "rbxts_include": {
        "$path": "include",
        "node_modules": {
          "$className": "Folder",
          "@rbxts": { "$path": "node_modules/@rbxts" },
          "@flamework": { "$path": "node_modules/@flamework" }
        }
      },
      "TS": {
        "$path": "out/shared"
      },
      "LobbyShared": {
        "$path": "out/lobby/shared"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "TS": {
          "$className": "Folder",
          "lobby": {
            "$path": "out/lobby/client"
          }
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true
      },
      "LobbyMap": {
        "$path": "assets/rbxm/Maps/LobbyMap.rbxm"
      }
    },
    "HttpService": {
      "$className": "HttpService",
      "$properties": {
        "HttpEnabled": true
      }
    },
    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
