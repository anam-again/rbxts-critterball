{
  "name": "critterball",
  "version": "1.0.0",
  "description": "A Roblox game where players roll around in a ball - Super Monkey Ball style",
  "main": "index.js",
  "scripts": {
    "build": "rbxtsc --rojo build.project.json",
    "watch": "rbxtsc -w --rojo build.project.json",
    "watch:lobby": "concurrently \"rbxtsc -w --rojo build.project.json\" \"rojo serve lobby.project.json\"",
    "watch:testing": "concurrently \"rbxtsc -w --rojo build.project.json\" \"rojo serve testing.project.json\"",
    "serve:lobby": "rojo serve lobby.project.json",
    "serve:testing": "rojo serve testing.project.json",
    "build:lobby": "npm run build && node -e \"require('fs').mkdirSync('build',{recursive:true})\" && rojo build lobby.project.json -o build/Lobby.rbxl",
    "build:testing": "npm run build && node -e \"require('fs').mkdirSync('build',{recursive:true})\" && rojo build testing.project.json -o build/Testing.rbxl",
    "build:all": "npm run build:lobby && npm run build:testing",
    "deploy:lobby": "rojo upload lobby.project.json --asset_id 105871392171885",
    "deploy:testing": "rojo upload testing.project.json --asset_id 89116331161137",
    "deploy:all": "npm run build && npm run deploy:lobby && npm run deploy:testing",
    "lint": "eslint --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@rbxts/types": "^1.0.760",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-roblox-ts": "^0.0.36",
    "prettier": "^3.2.5",
    "rbxts-transformer-flamework": "^1.1.1",
    "roblox-ts": "2.2.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@flamework/components": "^1.1.1",
    "@flamework/core": "^1.1.1",
    "@flamework/networking": "^1.3.2",
    "@rbxts/compiler-types": "^2.2.0-types.0",
    "@rbxts/object-utils": "^1.0.4",
    "@rbxts/services": "^1.5.4"
  }
}
