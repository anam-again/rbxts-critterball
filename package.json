{
  "name": "critterball",
  "version": "1.0.0",
  "description": "A Roblox game where players roll around in a ball - Super Monkey Ball style",
  "main": "index.js",
  "scripts": {
    "generate": "node scripts/generate-places.js",
    "prebuild": "npm run generate",
    "build": "rbxtsc --rojo build.project.json",
    "dev": "node scripts/dev.js",
    "dev:lobby": "node scripts/dev.js lobby",
    "dev:testing": "node scripts/dev.js testing",
    "build:rbxl": "node scripts/build-rbxl.js",
    "deploy": "node scripts/deploy.js",
    "deploy:all": "npm run build && node scripts/deploy.js all",
    "release": "npm run build && node scripts/build-rbxl.js all && node scripts/deploy.js all",
    "lint": "eslint --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@rbxts/types": "^1.0.760",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-roblox-ts": "^0.0.36",
    "prettier": "^3.2.5",
    "rbxts-transformer-flamework": "^1.1.1",
    "roblox-ts": "2.2.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@flamework/components": "^1.1.1",
    "@flamework/core": "^1.1.1",
    "@flamework/networking": "^1.3.2",
    "@rbxts/compiler-types": "^2.2.0-types.0",
    "@rbxts/object-utils": "^1.0.4",
    "@rbxts/services": "^1.5.4",
    "dotenv": "^17.3.1"
  }
}
